  m_EditorClassIdentifier: Assembly-CSharp::LessonData
  lessonID: 3
  cocID: COC_01
  lessonTitle: Computer Hardware
  description: "Learn the basic components, functions, terms, and concepts of computers to better understand how computer systems work."
  lessonSceneName: LessonScene
  requiredGoldLessonID: 2
  learningObjectives:
  - "• Identify the basic PC terms and concepts."
  - "• Explain the PC system."
  - "• Discuss the computer system unit case and its form factor."
  - "• Identify the major components of a computer system unit and its peripherals."
  - "• Identify the computer hardware peripherals."
  subtopics:
  - subtopicID: 0301
    subtopicName: Basic PC Terms and Concepts
  - subtopicID: 0302
    subtopicName: The PC System
  - subtopicID: 0303
