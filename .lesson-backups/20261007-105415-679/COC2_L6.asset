  m_EditorClassIdentifier: Assembly-CSharp::LessonData
  lessonID: 10
  cocID: COC_02
  lessonTitle: Network Cables
  description: "Learn the rules, tools, and techniques for properly pulling, documenting, terminating, and testing network cables, including the racks and raceways used to organize them."
  lessonSceneName: LessonScene
  requiredGoldLessonID: 9
  learningObjectives:
  - "• Identify network cables and cable raceway."
  - "• Install network cables and cable raceway."
  subtopics:
