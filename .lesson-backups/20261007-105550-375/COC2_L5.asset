  m_Name: COC2_L5
  m_EditorClassIdentifier: Assembly-CSharp::LessonData
  lessonID: 9
  cocID: COC_02
  lessonTitle: Splicing
  description: "Learn the standards and step-by-step procedures for structured cabling, including wall-plate installation, T568-A/B wiring schemes, and how to terminate RJ45, Cat 5e, and keystone jack connections."
  lessonSceneName: LessonScene
  requiredGoldLessonID: 8
  learningObjectives:
  - "• Identify standard splicing based on EIA/TIA."
  - "• Perform splicing based on EIA/TIA."
  subtopics:
  - subtopicID: 0901
    subtopicName: "Structured Cabling and Standardization"
