  m_Name: COC1_L1
  m_EditorClassIdentifier: Assembly-CSharp::LessonData
  lessonID: 1
  cocID: COC_01
  lessonTitle: OHS Policies and Procedures
  description: "\tThis lesson introduces Occupational Health and Safety (OHS) practices
    to help protect workers, others, and equipment from potential hazards."
  lessonSceneName: LessonScene
  requiredGoldLessonID: 0
  learningObjectives:
  - "\u2022 Discuss the Occupational Health and Safety (OHS) policies and procedures.\n"
  - "\u2022 Elaborate the three steps used to manage health and safety at work.\n"
  - "\u2022 Point-out the common hazards encountered by computer technicians and
    users.\n"
  - "\u2022 Identify the elements of the Occupational Health and Safety Standards.\n"
  - "\u2022 Explain the 5S Principles.\n"
  subtopics:
  - subtopicID: 0101
    subtopicName: Occupational Health and Safety Policies
