  m_Name: COC2_L5
  m_EditorClassIdentifier: Assembly-CSharp::LessonData
  lessonID: 9
  cocID: COC_02
  lessonTitle: Splicing
  description: 'Learn the standards and step-by-step procedures for structured cabling,
    including wall-plate installation, T568-A/B wiring schemes, and how to terminate
    RJ45, CAT5e, and keystone jack connections.

'
  lessonSceneName: LessonScene
  requiredGoldLessonID: 8
  learningObjectives:
  - "\u2022 Identify standard splicing based on EIA/TIA"
  - "\u2022 Perform splicing based on EIA/TIA"
  subtopics:
  - subtopicID: 0901
    subtopicName: 'Structured Cabling and Standardization '
  - subtopicID: 0902
    subtopicName: American National Standards Institute (ANSI)
  - subtopicID: 0903
    subtopicName: Electronic Industries Alliance (EIA)
  - subtopicID: 0904
    subtopicName: 'Telecommunications Industry Association (TIA) '
  - subtopicID: 0905
    subtopicName: 110-Blocks
  - subtopicID: 0906
    subtopicName: Wall-Plate Location
  - subtopicID: 0907
    subtopicName: Vertical Position
  - subtopicID: 0908
    subtopicName: Horizontal Position
  - subtopicID: 0909
    subtopicName: Wall-Plate Mounting System
  - subtopicID: 0910
    subtopicName: Outlet Boxes
  - subtopicID: 0911
