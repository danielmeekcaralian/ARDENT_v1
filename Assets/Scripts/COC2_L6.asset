  m_EditorClassIdentifier: Assembly-CSharp::LessonData
  lessonID: 10
  cocID: COC_02
  lessonTitle: Network Cables
  description: 'Learn the rules, tools, and techniquesfor properly pulling, documenting,
    terminating, and testing network cables, including the  racks and raceways used
    to organize them. '
  lessonSceneName: LessonScene
  requiredGoldLessonID: 9
  learningObjectives:
  - "\u2022 Identify network cables and cable raceway"
  - "\u2022 Install network cables and cable raceway"
  subtopics:
  - subtopicID: 1001
    subtopicName: Cabling Rules
  - subtopicID: 1002
    subtopicName: Networking Cables
  - subtopicID: 1003
    subtopicName: Pulling Cables
  - subtopicID: 1004
